# Local settings for ANJS. Copy this file to .env and edit as needed.
# .env is git-ignored; this example file is the one that gets committed.
# Values already set in your shell take priority over this file.

# --- Face ID (see FACE_ID_SETUP.md) --------------------------------------
# Folder holding the three model files. Relative paths start at the project root.
ANJS_MODELS_DIR=.data/models
ANJS_YOLO_MODEL=yolov8n-face.pt
ANJS_YUNET_MODEL=face_detection_yunet_2023mar.onnx
ANJS_SFACE_MODEL=face_recognition_sface_2021dec.onnx

# Webcam to use. Try 1, 2, ... if the wrong camera opens.
ANJS_CAMERA_INDEX=0

# Matching thresholds (cosine similarity) and how long the scan dialog waits.
ANJS_FACE_MIN_SCORE=0.60
ANJS_FACE_MIN_GAP=0.10
ANJS_FACE_SCAN_SECONDS=25

# --- Local AI assistant (Ollama) -----------------------------------------
ANJS_LLM_HOST=http://localhost:11434
ANJS_LLM_MODEL=llama3.2:3b

# --- Storage -------------------------------------------------------------
# Where store.json (accounts, orders, face templates) lives. Default: .data
# ANJS_DATA_DIR=.data
